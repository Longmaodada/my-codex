{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "My Codex",
  "version": "0.1.2",
  "identifier": "com.local.mycodex",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --port 1420",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/client"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "floating",
        "title": "My Codex",
        "url": "/?window=floating",
        "width": 320,
        "height": 500,
        "minWidth": 140,
        "minHeight": 56,
        "resizable": false,
        "fullscreen": false,
        "focus": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": true
      },
      {
        "label": "dashboard",
        "title": "My Codex Dashboard",
        "url": "/?window=dashboard",
        "width": 1360,
        "height": 860,
        "minWidth": 1050,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "shadow": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "My Codex",
    "copyright": "Copyright (c) 2026 My Codex contributors",
    "category": "DeveloperTool",
    "shortDescription": "Local-first Codex quota and usage monitor",
    "longDescription": "A local-first Codex quota widget and usage intelligence dashboard. Not affiliated with OpenAI.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
